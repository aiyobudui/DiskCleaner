<Window x:Class="DiskCleaner.Views.FailureDetailsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="清理详情" Width="760" MinHeight="140" MaxHeight="600"
        SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize"
        Icon="{x:Null}"
        Background="{DynamicResource bg-primary}"
        Foreground="{DynamicResource text-primary}"
        FontFamily="Microsoft YaHei UI" FontSize="13"
        BorderBrush="{DynamicResource bg-tertiary}" BorderThickness="1">
    <Window.Resources>
        <!-- 与 MainWindow/SettingsWindow 一致的画刷；由 ThemeService.ApplyTo 随深/浅色切换实时更新 -->
        <SolidColorBrush x:Key="bg-primary" Color="#1E1E2E"/>
        <SolidColorBrush x:Key="bg-secondary" Color="#313244"/>
        <SolidColorBrush x:Key="bg-tertiary" Color="#45475A"/>
        <SolidColorBrush x:Key="bg-sidebar" Color="#181825"/>
        <SolidColorBrush x:Key="bg-deep" Color="#11111B"/>
        <SolidColorBrush x:Key="bg-item" Color="#262637"/>
        <SolidColorBrush x:Key="bg-item-hover" Color="#2A2B3D"/>
        <SolidColorBrush x:Key="text-primary" Color="#CDD6F4"/>
        <SolidColorBrush x:Key="text-secondary" Color="#A6ADC8"/>
        <SolidColorBrush x:Key="text-muted" Color="#6C7086"/>
        <SolidColorBrush x:Key="border-color" Color="#585B70"/>
        <SolidColorBrush x:Key="border-subtle" Color="#45475A"/>
        <SolidColorBrush x:Key="accent-blue" Color="#89B4FA"/>
        <SolidColorBrush x:Key="accent-green" Color="#A6E3A1"/>
        <SolidColorBrush x:Key="accent-yellow" Color="#F9E2AF"/>
        <SolidColorBrush x:Key="accent-red" Color="#F38BA8"/>
        <SolidColorBrush x:Key="accent-mauve" Color="#CBA6F7"/>
        <SolidColorBrush x:Key="text-on-accent" Color="#FFFFFF"/>
    </Window.Resources>
    <ScrollViewer Margin="12" VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled">
        <StackPanel>
            <StackPanel x:Name="DescriptionPanel">
                <TextBlock Text="说明" FontSize="12" FontWeight="SemiBold"
                           Foreground="{DynamicResource text-secondary}" Margin="0,0,0,4"/>
                <TextBlock x:Name="DescriptionText" TextWrapping="Wrap" FontSize="12"
                           Foreground="{DynamicResource text-secondary}"/>
            </StackPanel>

            <StackPanel x:Name="TargetPathsPanel" Margin="0,8,0,0">
                <TextBlock Text="将清理以下位置：" FontSize="12" FontWeight="SemiBold"
                           Foreground="{DynamicResource text-secondary}" Margin="0,0,0,4"/>
                <Border Background="{DynamicResource bg-secondary}" BorderBrush="{DynamicResource bg-tertiary}"
                        BorderThickness="1" CornerRadius="6" Padding="8">
                    <TextBox x:Name="TargetPathsText" IsReadOnly="True" AcceptsReturn="True" BorderThickness="0"
                             Background="Transparent" Foreground="{DynamicResource text-secondary}"
                             FontFamily="Consolas" FontSize="12" TextWrapping="Wrap"/>
                </Border>
            </StackPanel>

            <StackPanel x:Name="TargetFilesPanel" Margin="0,8,0,0">
                <TextBlock Text="将清理的文件（预览前 500 项）：" FontSize="12" FontWeight="SemiBold"
                           Foreground="{DynamicResource text-secondary}" Margin="0,0,0,4"/>
                <Border Background="{DynamicResource bg-secondary}" BorderBrush="{DynamicResource bg-tertiary}"
                        BorderThickness="1" CornerRadius="6" Padding="8">
                    <TextBox x:Name="TargetFilesText" IsReadOnly="True" AcceptsReturn="True" BorderThickness="0"
                             Background="Transparent" Foreground="{DynamicResource text-secondary}"
                             FontFamily="Consolas" FontSize="12" TextWrapping="Wrap"/>
                </Border>
            </StackPanel>

            <StackPanel x:Name="FailurePanel" Margin="0,8,0,0">
                <TextBlock Text="失败明细" FontSize="12" FontWeight="SemiBold"
                           Foreground="{DynamicResource text-secondary}" Margin="0,0,0,4"/>
                <Border Background="{DynamicResource bg-secondary}" BorderBrush="{DynamicResource bg-tertiary}"
                        BorderThickness="1" CornerRadius="6" Padding="8">
                    <TextBox x:Name="FailureText" IsReadOnly="True" AcceptsReturn="True" BorderThickness="0"
                             Background="Transparent" Foreground="{DynamicResource accent-red}"
                             FontFamily="Consolas" FontSize="12" TextWrapping="Wrap"/>
                </Border>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</Window>
