<Window x:Class="DiskCleaner.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:DiskCleaner.ViewModels"
        xmlns:cv="clr-namespace:DiskCleaner.Converters"
        xmlns:m="clr-namespace:DiskCleaner.Models"
        xmlns:b="clr-namespace:DiskCleaner.Behaviors"
        Title="九歌・系统清洁小工具" Height="780" Width="1200"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None" ResizeMode="CanResize"
        Background="{DynamicResource bg-primary}" Foreground="{DynamicResource text-primary}">

    <WindowChrome.WindowChrome>
        <!-- 自定义无边框窗口：用 CaptionHeight 让操作系统在标题栏区域(顶 38px)原生处理拖拽与双击最大化，
             零延迟、任意 DPI 稳定。标题栏内按钮需 IsHitTestVisibleInChrome=True 才能正常点击。 -->
        <WindowChrome GlassFrameThickness="0" CaptionHeight="38"
                      ResizeBorderThickness="6" CornerRadius="0"/>
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <!-- Converters -->
        <cv:PercentToDashConverter x:Key="PercentToDash"/>
        <cv:ProgressToWidthConverter x:Key="ProgressToWidth"/>
        <cv:StringToVisibilityConverter x:Key="StringToVisibility"/>
        <cv:IntToVisibilityConverter x:Key="IntToVisibility"/>
        <cv:BoolToVisibilityConverter x:Key="BoolToVisibility"/>
        <cv:ScanStatusToVisibilityConverter x:Key="ScanStatusToVisibility"/>
        <cv:AdminLockVisibilityConverter x:Key="AdminLockVisibility"/>
        <cv:AdminLockEnabledConverter x:Key="AdminLockEnabled"/>
        <cv:BoolToBorderThicknessConverter x:Key="BoolToBorderThickness"/>

        <!-- 清理树节点模板：按数据类型自动选择，支持分组嵌 ?-->
        <!--
            树节点统一列宽
            父分组 [checkbox 32][arrow 18][name *][size auto]
            叶子 [checkbox 32][name *][size auto]
            子树左缩进 18，使叶子 name 与父分组 name 在同一竖线，容量列也对齐
        -->
        <DataTemplate DataType="{x:Type m:CleanGroup}">
            <StackPanel Visibility="{Binding IsVisible, Converter={StaticResource BoolToVisibility}}">
                <Border Style="{DynamicResource GroupHeader}" Padding="16,8,16,8">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="32"/>
                            <ColumnDefinition Width="18"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <CheckBox Grid.Column="0" IsChecked="{Binding IsChecked}" IsThreeState="True"
                                  Style="{DynamicResource ModernCheckBox}" VerticalAlignment="Center"
                                  HorizontalAlignment="Center"/>
                        <TextBlock Grid.Column="1" FontSize="11" Foreground="{DynamicResource text-muted}"
                                   VerticalAlignment="Center" HorizontalAlignment="Center"
                                   Cursor="Hand" MouseLeftButtonDown="GroupHeader_ToggleExpanded">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Text" Value="&#x25BC;"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsExpanded}" Value="False">
                                            <Setter Property="Text" Value="&#x25B6;"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        <!-- 标题/容量区域可折叠；复选框不触发展开，箭 ? ?)与标题均触发 -->
                        <Border Grid.Column="2" Grid.ColumnSpan="2" Background="Transparent" Cursor="Hand"
                                MouseLeftButtonDown="GroupHeader_ToggleExpanded" Padding="10,0,0,0">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto" SharedSizeGroup="CleanItemSize"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="{Binding Name}" FontSize="13" FontWeight="SemiBold"
                                           Foreground="{DynamicResource text-primary}" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="1" Text="{Binding TotalSizeText}" FontSize="13"
                                           Foreground="{DynamicResource accent-blue}" VerticalAlignment="Center"
                                           HorizontalAlignment="Right" Margin="12,0,0,0"/>
                            </Grid>
                        </Border>
                    </Grid>
                </Border>
                <!-- 子树容器：左侧竖 ?+ 18px 缩进，明确上下级关系 ?
                     注意：竖线必须单独放在一个 Border 上并设置 Opacity，不能把 ItemsControl
                     包在同一个带 Opacity 的容器里，否则浅色模式下子项文字会被整体降透明度导致看不清 -->
                <Grid Margin="18,0,16,4">
                    <Border BorderBrush="{DynamicResource border-color}" BorderThickness="1,0,0,0" Opacity="0.4"/>
                    <ItemsControl ItemsSource="{Binding Children}" Margin="8,0,0,0">
                        <ItemsControl.Style>
                            <Style TargetType="ItemsControl">
                                <Setter Property="Visibility" Value="Visible"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsExpanded}" Value="False">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </ItemsControl.Style>
                    </ItemsControl>
                </Grid>
            </StackPanel>
        </DataTemplate>

        <DataTemplate DataType="{x:Type m:CleanItem}">
            <Border Background="Transparent" Padding="8,6" Margin="0,0,0,2"
                    Visibility="{Binding IsVisible, Converter={StaticResource BoolToVisibility}}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="32"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto" SharedSizeGroup="CleanItemSize"/>
                    </Grid.ColumnDefinitions>
                    <CheckBox Grid.Column="0" IsChecked="{Binding IsChecked}" Style="{DynamicResource ModernCheckBox}"
                              VerticalAlignment="Center" HorizontalAlignment="Center"/>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="10,0,0,0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding Name}" FontSize="12" Foreground="{DynamicResource text-secondary}"
                                       VerticalAlignment="Center"/>
                            <TextBlock Text="&#x24D8;" FontSize="14" Foreground="{DynamicResource text-muted}"
                                       VerticalAlignment="Center" Margin="6,0,0,0" Cursor="Help"
                                       ToolTipService.InitialShowDelay="100"
                                       ToolTipService.BetweenShowDelay="30000"
                                       ToolTipService.ShowDuration="20000">
                                <TextBlock.ToolTip>
                                    <ToolTip MaxWidth="420">
                                        <TextBlock Text="{Binding Description}" TextWrapping="Wrap" FontSize="12"/>
                                    </ToolTip>
                                </TextBlock.ToolTip>
                            </TextBlock>
                            <TextBlock Text="{Binding StatusText}" FontSize="11" FontWeight="Medium"
                                       Foreground="{Binding StatusColor}" VerticalAlignment="Center"
                                       Margin="6,0,0,0" Cursor="Help"
                                       ToolTipService.InitialShowDelay="100"
                                       ToolTipService.BetweenShowDelay="30000"
                                       ToolTipService.ShowDuration="20000"
                                       ToolTip="点击右侧「查看清理项」查看将清理的位置与文件；失败项点「查看失败详情」"
                                       Visibility="{Binding Status, Converter={StaticResource ScanStatusToVisibility}}"/>
                            <Button Content="查看清理项" Command="{Binding ShowFailureDetailsCommand}" CommandParameter="{Binding}"
                                    Visibility="{Binding HasTargetPathsOnly, Converter={StaticResource BoolToVisibility}}"
                                    Style="{DynamicResource MiniButton}" FontSize="11" Padding="6,2" Margin="6,0,0,0"/>
                            <Button Content="查看失败详情" Command="{Binding ShowFailureDetailsCommand}" CommandParameter="{Binding}"
                                    Visibility="{Binding HasFailureDetails, Converter={StaticResource BoolToVisibility}}"
                                    Style="{DynamicResource MiniButton}" FontSize="11" Padding="6,2" Margin="6,0,0,0"/>
                            <!-- 浏览器/客户端正在运行时显示：关闭并清理按钮 -->
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="6,0,0,0"
                                        Visibility="{Binding CanKillAndClean, Converter={StaticResource BoolToVisibility}}">
                                <Button Content="关闭并清理" Command="{Binding KillAndCleanCommand}" CommandParameter="{Binding}"
                                        Style="{DynamicResource MiniButton}"
                                        Foreground="{DynamicResource accent-red}" FontSize="11" Padding="6,2" Margin="4,0,0,0"/>
                            </StackPanel>
                        </StackPanel>
                    </StackPanel>
                    <TextBlock Grid.Column="2" Text="{Binding SizeText}" FontSize="12"
                               Foreground="{DynamicResource accent-green}" VerticalAlignment="Center"
                               HorizontalAlignment="Right" Margin="12,0,0,0"/>
                </Grid>
            </Border>
        </DataTemplate>

        <!-- Brushes -->
        <SolidColorBrush x:Key="bg-primary" Color="#1E1E2E"/>
        <SolidColorBrush x:Key="bg-secondary" Color="#313244"/>
        <SolidColorBrush x:Key="bg-tertiary" Color="#45475A"/>
        <SolidColorBrush x:Key="bg-sidebar" Color="#181825"/>
        <SolidColorBrush x:Key="bg-item" Color="#262637"/>
        <SolidColorBrush x:Key="bg-item-hover" Color="#2A2B3D"/>
        <SolidColorBrush x:Key="text-primary" Color="#CDD6F4"/>
        <SolidColorBrush x:Key="text-secondary" Color="#A6ADC8"/>
        <SolidColorBrush x:Key="text-muted" Color="#6C7086"/>
        <SolidColorBrush x:Key="accent-blue" Color="#89B4FA"/>
        <SolidColorBrush x:Key="accent-green" Color="#A6E3A1"/>
        <SolidColorBrush x:Key="accent-yellow" Color="#F9E2AF"/>
        <SolidColorBrush x:Key="accent-red" Color="#F38BA8"/>
        <SolidColorBrush x:Key="accent-mauve" Color="#CBA6F7"/>
        <SolidColorBrush x:Key="border-color" Color="#585B70"/>
        <SolidColorBrush x:Key="border-subtle" Color="#45475A"/>
        <!-- 亮色 accent 背景上的固定深色文字（不随主题变化） -->
        <SolidColorBrush x:Key="text-on-accent" Color="#FFFFFF"/>

        <!-- ══════════════ ?Sidebar TabControl Style ══════════════ ?-->
        <Style x:Key="SidebarNav" TargetType="TabControl">
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabControl">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="244"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <!-- Sidebar -->
                            <Border Grid.Column="0" Background="{DynamicResource bg-sidebar}">
                                <DockPanel LastChildFill="True">
                                    <!-- Nav items host -->
                                    <StackPanel IsItemsHost="True" KeyboardNavigation.TabIndex="1" Margin="0,24,0,0"/>
                                </DockPanel>
                            </Border>

                            <!-- Content area -->
                            <Grid Grid.Column="1">
                                <ContentPresenter ContentSource="SelectedContent"/>
                            </Grid>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ══════════════ ?Nav Item (TabItem) Style  ?朴素侧边导航（非卡片 ?══════════════ ?-->
        <Style x:Key="NavItem" TargetType="TabItem">
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource text-muted}"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border x:Name="Border" Background="{TemplateBinding Background}"
                                BorderThickness="0" Padding="24,13" Margin="0,1">
                            <ContentPresenter ContentSource="Header" VerticalAlignment="Center" HorizontalAlignment="Left"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter Property="Foreground" Value="{DynamicResource accent-blue}"/>
                                <Setter TargetName="Border" Property="Background" Value="{DynamicResource bg-tertiary}"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="{DynamicResource text-secondary}"/>
                                <Setter TargetName="Border" Property="Background" Value="{DynamicResource bg-secondary}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ══════════════ ?Button Styles ══════════════ ?-->
        <Style x:Key="SecondaryButton" TargetType="Button">
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Background" Value="{DynamicResource bg-secondary}"/>
            <Setter Property="Foreground" Value="{DynamicResource text-primary}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Padding" Value="12,7"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="7" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="{DynamicResource bg-tertiary}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="bd" Property="Opacity" Value="0.4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="MiniButton" TargetType="Button" BasedOn="{StaticResource SecondaryButton}">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Padding" Value="10,4"/>
        </Style>

        <!-- ══════════════ ?Card Style ══════════════ ?-->
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource bg-secondary}"/>
            <Setter Property="CornerRadius" Value="14"/>
            <Setter Property="Padding" Value="16,14"/>
        </Style>

        <!-- ══════════════ ?Clickable Card Border (for double-click only) ══════════════ ?-->
        <Style x:Key="CardBorder" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource bg-secondary}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="CornerRadius" Value="14"/>
            <Setter Property="Padding" Value="16,14"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{DynamicResource bg-item-hover}"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- ══════════════ ?Group Header Style (可折叠分组标题统一样式) ══════════════ ?-->
        <Style x:Key="GroupHeader" TargetType="Border">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Padding" Value="16,8,16,12"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="BorderBrush" Value="{DynamicResource border-color}"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
        </Style>

        <!-- ══════════════ ?Progress Bar Styles ══════════════ ?-->
        <!-- 优雅的胶囊形进度条：确定态像素级精确填充，不确定态单条平滑滑动胶囊 -->
        <Style x:Key="RoundedProgress" TargetType="ProgressBar">
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Height" Value="6"/>
            <Setter Property="MinHeight" Value="6"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Background" Value="{DynamicResource bg-tertiary}"/>
            <Setter Property="Foreground" Value="{DynamicResource accent-blue}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ProgressBar">
                        <Grid x:Name="Root">
                            <!-- 轨道（胶囊形） -->
                            <Border Background="{TemplateBinding Background}" CornerRadius="3" SnapsToDevicePixels="True"/>
                            <!-- 确定态填充：像素级精确，胶囊形两端圆角 -->
                            <Border x:Name="PART_Indicator" Background="{TemplateBinding Foreground}" CornerRadius="3"
                                    HorizontalAlignment="Left" SnapsToDevicePixels="True">
                                <Border.Width>
                                    <MultiBinding Converter="{StaticResource ProgressToWidth}">
                                        <Binding Path="Value" RelativeSource="{RelativeSource TemplatedParent}"/>
                                        <Binding Path="Maximum" RelativeSource="{RelativeSource TemplatedParent}"/>
                                        <Binding Path="ActualWidth" RelativeSource="{RelativeSource TemplatedParent}"/>
                                    </MultiBinding>
                                </Border.Width>
                            </Border>
                            <!-- 不确定态（跑马灯）：单条平滑滑动的胶囊 -->
                            <Grid x:Name="IndeterminateRoot" Visibility="Collapsed" ClipToBounds="True">
                                <Rectangle x:Name="IndeterminatePill" Width="160" Height="6" RadiusX="3" RadiusY="3"
                                           Fill="{TemplateBinding Foreground}" Opacity="0.9">
                                    <Rectangle.RenderTransform>
                                        <TranslateTransform X="-180"/>
                                    </Rectangle.RenderTransform>
                                </Rectangle>
                            </Grid>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsIndeterminate" Value="True">
                                <Setter TargetName="PART_Indicator" Property="Visibility" Value="Collapsed"/>
                                <Setter TargetName="IndeterminateRoot" Property="Visibility" Value="Visible"/>
                                <Trigger.EnterActions>
                                    <BeginStoryboard x:Name="IndSb">
                                        <Storyboard RepeatBehavior="Forever">
                                            <DoubleAnimation Storyboard.TargetName="IndeterminatePill"
                                                             Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.X)"
                                                             From="-180" To="900" Duration="0:0:1.8" RepeatBehavior="Forever">
                                                <DoubleAnimation.EasingFunction>
                                                    <SineEase EasingMode="EaseInOut"/>
                                                </DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <StopStoryboard BeginStoryboardName="IndSb"/>
                                </Trigger.ExitActions>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ══════════════ ?ListBox Style ══════════════ ?-->
        <Style x:Key="ModernListBox" TargetType="ListBox">
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource text-primary}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="b:ScrollBubbleBehavior.Enabled" Value="True"/>
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled"/>
            <Setter Property="ItemContainerStyle">
                <Setter.Value>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="Background" Value="Transparent"/>
                        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                        <Setter Property="Padding" Value="0"/>
                        <Setter Property="Margin" Value="0,0,0,6"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ListBoxItem">
                                    <ContentPresenter/>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ══════════════ ?TitleBar Button Styles ══════════════ ?-->
        <Style x:Key="WindowButton" TargetType="Button">
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource text-primary}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                              TextElement.Foreground="{TemplateBinding Foreground}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="{DynamicResource bg-item-hover}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="{DynamicResource bg-tertiary}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ══════════════ ?CheckBox Style ══════════════ ?-->
        <Style x:Key="ModernCheckBox" TargetType="CheckBox">
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Foreground" Value="{DynamicResource text-primary}"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Border x:Name="box" Width="16" Height="16" CornerRadius="0"
                                    Background="{DynamicResource bg-tertiary}"
                                    BorderBrush="{DynamicResource border-color}" BorderThickness="1.5">
                                <TextBlock x:Name="check" Text="&#x2714;" FontSize="10" FontWeight="Bold"
                                           Foreground="{DynamicResource text-on-accent}"
                                           HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed"/>
                            </Border>
                            <ContentPresenter Content="{TemplateBinding Content}" Margin="6,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter Property="Background" Value="{DynamicResource accent-blue}"/>
                                <Setter Property="BorderBrush" Value="{DynamicResource accent-blue}"/>
                                <Setter TargetName="check" Property="Visibility" Value="Visible"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="{x:Null}">
                                <Setter Property="Background" Value="{DynamicResource accent-blue}"/>
                                <Setter Property="BorderBrush" Value="{DynamicResource accent-blue}"/>
                                <Setter TargetName="check" Property="Text" Value="&#x2212;"/>
                                <Setter TargetName="check" Property="FontSize" Value="14"/>
                                <Setter TargetName="check" Property="Visibility" Value="Visible"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="BorderBrush" Value="{DynamicResource accent-blue}"/>
                                <Setter Property="Background" Value="{DynamicResource bg-item-hover}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ══════════════ ?ComboBox Styles ══════════════ ?-->
        <Style x:Key="ModernComboBoxItem" TargetType="ComboBoxItem">
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="MinHeight" Value="22"/>
            <Setter Property="Padding" Value="8,2"/>
            <Setter Property="Foreground" Value="{DynamicResource text-primary}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border x:Name="Bd"
                                Background="Transparent"
                                Padding="{TemplateBinding Padding}"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Left" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource accent-blue}"/>
                                <Setter Property="Foreground" Value="{DynamicResource text-on-accent}"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource accent-blue}"/>
                                <Setter Property="Foreground" Value="{DynamicResource text-on-accent}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ModernComboBox" TargetType="ComboBox">
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Background" Value="{DynamicResource bg-tertiary}"/>
            <Setter Property="Foreground" Value="{DynamicResource text-primary}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource border-color}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="MinHeight" Value="24"/>
            <Setter Property="Padding" Value="6,2"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="ItemContainerStyle" Value="{StaticResource ModernComboBoxItem}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <!-- 视觉主体 -->
                            <Border x:Name="MainBorder"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="0"
                                    Padding="{TemplateBinding Padding}"
                                    SnapsToDevicePixels="True">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <ContentPresenter Grid.Column="0"
                                                      Content="{TemplateBinding SelectionBoxItem}"
                                                      ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                                      ContentStringFormat="{TemplateBinding SelectionBoxItemStringFormat}"
                                                      HorizontalAlignment="Left"
                                                      VerticalAlignment="Center"
                                                      IsHitTestVisible="False"/>
                                    <Path Grid.Column="1"
                                          Data="M 0 0 L 5 5 L 10 0 Z"
                                          Fill="{TemplateBinding Foreground}"
                                          VerticalAlignment="Center"
                                          HorizontalAlignment="Center"
                                          Width="10" Height="5"
                                          Stretch="None"
                                          Margin="8,0,0,0"
                                          IsHitTestVisible="False"/>
                                </Grid>
                            </Border>

                            <!-- 点击层：负责打开/关闭下拉，透明且不占用焦点 -->
                            <ToggleButton x:Name="ToggleButton"
                                          Focusable="False"
                                          Opacity="0"
                                          ClickMode="Press"
                                          HorizontalAlignment="Stretch"
                                          VerticalAlignment="Stretch"
                                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border Background="Transparent"/>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>

                            <!-- 自定义下拉弹出层 -->
                            <Popup x:Name="PART_Popup"
                                   Placement="Bottom"
                                   PlacementTarget="{Binding ElementName=MainBorder}"
                                   IsOpen="{TemplateBinding IsDropDownOpen}"
                                   StaysOpen="False"
                                   AllowsTransparency="True"
                                   PopupAnimation="Slide">
                                <Border Background="{DynamicResource bg-tertiary}"
                                        BorderBrush="{DynamicResource border-color}"
                                        BorderThickness="1"
                                        CornerRadius="0"
                                        SnapsToDevicePixels="True">
                                    <ScrollViewer x:Name="DropDownScrollViewer" MaxHeight="200">
                                        <ItemsPresenter x:Name="ItemsPresenter"
                                                        KeyboardNavigation.DirectionalNavigation="Contained"
                                                        SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}"/>
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="MainBorder" Property="BorderBrush" Value="{DynamicResource accent-blue}"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                <Setter TargetName="MainBorder" Property="BorderBrush" Value="{DynamicResource accent-blue}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ══════════════ ?TextBox Style ══════════════ ?-->
        <Style x:Key="ModernTextBox" TargetType="TextBox">
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Background" Value="{DynamicResource bg-tertiary}"/>
            <Setter Property="Foreground" Value="{DynamicResource text-primary}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource border-color}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="CaretBrush" Value="{DynamicResource text-primary}"/>
        </Style>

        <!-- ══════════════ ?Section Header Style ══════════════ ?-->
        <Style x:Key="SectionHeader" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="{DynamicResource text-secondary}"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
        </Style>

        <!-- 标签页内容根容器：统一各页外边距（左右 35、上下 24） -->
        <Style x:Key="ContentRoot" TargetType="StackPanel">
            <Setter Property="Margin" Value="35,24"/>
        </Style>

        <!-- ══════════════ 右键管理：内层 TabControl ══════════════ -->
        <Style x:Key="ContextMenuTabControl" TargetType="TabControl">
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabControl">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <TabPanel Grid.Row="0" IsItemsHost="True" Background="Transparent"/>
                            <ContentPresenter Grid.Row="1" ContentSource="SelectedContent" Margin="0,12,0,0"/>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ContextMenuTabItem" TargetType="TabItem">
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource text-muted}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Padding" Value="12,8"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border x:Name="Border" Background="Transparent" Padding="{TemplateBinding Padding}"
                                BorderThickness="0,0,0,2" BorderBrush="Transparent">
                            <ContentPresenter ContentSource="Header" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Border" Property="BorderBrush" Value="{DynamicResource accent-blue}"/>
                                <Setter Property="Foreground" Value="{DynamicResource accent-blue}"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="{DynamicResource text-secondary}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 开关：黑色/深灰=关闭，黄色=开启 -->
        <Style x:Key="ToggleSwitch" TargetType="CheckBox">
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Width" Value="36"/>
            <Setter Property="Height" Value="20"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="IsEnabled" Value="{Binding CanToggle}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Border x:Name="Track" Width="36" Height="20" CornerRadius="10"
                                Background="#444444" BorderThickness="0" SnapsToDevicePixels="True">
                            <Border x:Name="Thumb" Width="16" Height="16" CornerRadius="8"
                                    Background="White" HorizontalAlignment="Left" VerticalAlignment="Center"
                                    Margin="2,0,0,0">
                                <Border.RenderTransform>
                                    <TranslateTransform x:Name="ThumbTranslate" X="0"/>
                                </Border.RenderTransform>
                            </Border>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Track" Property="Background" Value="#F5A623"/>
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="ThumbTranslate"
                                                             Storyboard.TargetProperty="X"
                                                             To="16" Duration="0:0:0.15"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="ThumbTranslate"
                                                             Storyboard.TargetProperty="X"
                                                             To="0" Duration="0:0:0.15"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Track" Property="Opacity" Value="0.4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 右键管理：列表项数据模板 -->
        <DataTemplate DataType="{x:Type m:ContextMenuItem}">
            <Border Style="{DynamicResource Card}" Margin="0,0,0,6" Padding="12,10">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" ToolTipService.ToolTip="{Binding ToolTipText}">
                        <Image Source="{Binding Icon}" Width="20" Height="20" Margin="0,0,8,0" VerticalAlignment="Center"/>
                        <StackPanel Orientation="Vertical" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="{Binding DisplayName}" FontSize="12" FontWeight="SemiBold"
                                           Foreground="{DynamicResource text-primary}" TextTrimming="CharacterEllipsis"/>
                                <Border Margin="6,0,0,0" Padding="6,1" CornerRadius="3" VerticalAlignment="Center"
                                        Background="{DynamicResource accent-yellow}"
                                        Visibility="{Binding IsWin11TopLevel, Converter={StaticResource BoolToVisibility}}">
                                    <TextBlock Text="Win11一级" FontSize="9" FontWeight="Bold" Foreground="#1e1e1e"/>
                                </Border>
                            </StackPanel>
                            <TextBlock Text="{Binding Scope}" FontSize="10"
                                       Foreground="{DynamicResource text-muted}" TextTrimming="CharacterEllipsis"
                                       Margin="0,2,0,0"
                                       Visibility="{Binding Scope, Converter={StaticResource StringToVisibility}}"/>
                        </StackPanel>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="8,0,0,0">
                        <CheckBox IsChecked="{Binding IsEnabled, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                  Style="{DynamicResource ToggleSwitch}" VerticalAlignment="Center"
                                  Visibility="{Binding IsDeleted, Converter={StaticResource BoolToVisibility}, ConverterParameter=inverted}"/>
                        <Button Margin="10,0,0,0" Padding="10,4" VerticalAlignment="Center" CommandParameter="{Binding}">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource MiniButton}">
                                    <Setter Property="Content" Value="删除"/>
                                    <Setter Property="ToolTip" Value="永久删除该右键项（删除前自动备份，可随时撤销）"/>
                                    <Setter Property="IsEnabled" Value="{Binding CanDelete}"/>
                                    <Setter Property="Command" Value="{Binding DataContext.DeleteContextMenuItemCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsDeleted}" Value="True">
                                            <Setter Property="Content" Value="撤销"/>
                                            <Setter Property="ToolTip" Value="撤销删除，恢复该右键项（重新导入之前备份的注册表）"/>
                                            <Setter Property="IsEnabled" Value="True"/>
                                            <Setter Property="Command" Value="{Binding DataContext.RestoreContextMenuItemCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>
        </DataTemplate>
    </Window.Resources>

    <Border BorderThickness="1" BorderBrush="{DynamicResource border-color}" Background="{DynamicResource bg-primary}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- 顶部工具条：左侧 sidebar 色块，标题+版本置于侧栏右侧（内容区上方），右侧窗口控制按 ?
                 左侧叠一层 sidebar 色块，使左侧菜单栏在视觉上贯穿整个程序高度（含标题栏区域） -->
            <Border Grid.Row="0" Height="38" Background="Transparent">
                <Grid>
                    <Border Width="244" HorizontalAlignment="Left" VerticalAlignment="Stretch" Background="{DynamicResource bg-sidebar}"/>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Left" Margin="260,0,0,0">
                        <TextBlock Text="九歌・系统清洁小工具" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource text-primary}" VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding VersionSuffix}" FontSize="10" Foreground="{DynamicResource text-muted}" VerticalAlignment="Center" Margin="4,2,0,0"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,6,0">
                        <Button Content="{Binding ThemeIcon}" Command="{Binding ToggleThemeCommand}"
                            Width="34" Height="28" Style="{DynamicResource WindowButton}"
                            FontSize="14" ToolTip="切换深色 / 浅色模式"
                            WindowChrome.IsHitTestVisibleInChrome="True"/>
                    <Button Content="&#x2014;" Click="Minimize_Click" Width="34" Height="28"
                            Style="{DynamicResource WindowButton}" FontSize="16"
                            WindowChrome.IsHitTestVisibleInChrome="True"/>
                    <Button Content="&#x2715;" Click="Close_Click" Width="34" Height="28"
                            Style="{DynamicResource WindowButton}" FontSize="14"
                            WindowChrome.IsHitTestVisibleInChrome="True"/>
                </StackPanel>
                </Grid>
            </Border>

            <TabControl Grid.Row="1" Style="{DynamicResource SidebarNav}" Padding="0" BorderThickness="0"
                        SelectedIndex="{Binding SelectedTabIndex, Mode=TwoWay}">


        <!-- ══════════════ ?Tab 1: Dashboard ══════════════ ?-->
        <TabItem Style="{DynamicResource NavItem}">
            <TabItem.Header>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#x1F4CA;" FontSize="14" Margin="0,0,10,0"/>
                    <TextBlock Text="&#x4EEA;&#x8868;&#x76D8;" FontSize="13"/>
                </StackPanel>
            </TabItem.Header>
            <ScrollViewer VerticalScrollBarVisibility="Auto" Background="{DynamicResource bg-primary}">
                <StackPanel Style="{DynamicResource ContentRoot}">

                    <!-- 系统信息（四张独立卡片，风格同性能监控 ?-->
                    <TextBlock Text="&#x7CFB;&#x7EDF;&#x4FE1;&#x606F;" Style="{DynamicResource SectionHeader}"/>
                    <Grid Margin="0,0,0,15">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- 系统版本 -->
                        <Border Grid.Column="0" Style="{DynamicResource Card}" Margin="0,0,8,0">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,5">
                                    <TextBlock Text="&#x1F4BB;" FontSize="15" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="&#x7CFB;&#x7EDF;&#x7248;&#x672C;" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource text-secondary}" VerticalAlignment="Center"/>
                                </StackPanel>
                                <TextBlock Text="{Binding SystemVersion}" FontSize="11" Foreground="{DynamicResource text-primary}" TextWrapping="Wrap" LineHeight="18"/>
                                <TextBlock Text="{Binding SystemVersionDetail}" FontSize="11" Foreground="{DynamicResource text-muted}" Margin="0,3,0,0" TextWrapping="Wrap" Visibility="{Binding SystemVersionDetail, Converter={StaticResource StringToVisibility}}"/>
                            </StackPanel>
                        </Border>

                        <!-- CPU -->
                        <Border Grid.Column="1" Style="{DynamicResource Card}" Margin="0,0,8,0">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,5">
                                    <TextBlock Text="&#x1F9E0;" FontSize="15" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="CPU" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource text-secondary}" VerticalAlignment="Center"/>
                                </StackPanel>
                                <TextBlock Text="{Binding CpuModel}" FontSize="11" Foreground="{DynamicResource text-primary}" TextWrapping="Wrap" LineHeight="18"/>
                                <TextBlock Text="{Binding CpuDetail}" FontSize="11"
                                           Foreground="{DynamicResource text-muted}"
                                           Margin="0,3,0,0" TextWrapping="Wrap"
                                           Visibility="{Binding CpuDetail, Converter={StaticResource StringToVisibility}}"/>
                            </StackPanel>
                        </Border>

                        <!-- 内存 -->
                        <Border Grid.Column="2" Style="{DynamicResource Card}" Margin="0,0,8,0">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,5">
                                    <TextBlock Text="&#x1F4D0;" FontSize="15" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="&#x5185;&#x5B58;" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource text-secondary}" VerticalAlignment="Center"/>
                                </StackPanel>
                                <TextBlock Text="{Binding MemoryModel}" FontSize="11" Foreground="{DynamicResource text-primary}" TextWrapping="Wrap" LineHeight="18"/>
                                <TextBlock Text="{Binding MemoryDetail}" FontSize="11" Foreground="{DynamicResource text-muted}" Margin="0,3,0,0" TextWrapping="Wrap" Visibility="{Binding MemoryDetail, Converter={StaticResource StringToVisibility}}"/>
                            </StackPanel>
                        </Border>

                        <!-- 显卡 -->
                        <Border Grid.Column="3" Style="{DynamicResource Card}">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,5">
                                    <TextBlock Text="&#x1F3AE;" FontSize="15" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="&#x663E;&#x5361;" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource text-secondary}" VerticalAlignment="Center"/>
                                </StackPanel>
                                <TextBlock Text="{Binding GpuModel}" FontSize="11" Foreground="{DynamicResource text-primary}" TextWrapping="Wrap" LineHeight="18"/>
                            </StackPanel>
                        </Border>
                    </Grid>

                    <TextBlock Text="&#x6027;&#x80FD;&#x76D1;&#x63A7;" Style="{DynamicResource SectionHeader}"/>
                    <Grid Margin="0,0,0,15">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- CPU Gauge -->
                        <Border Grid.Column="0" Style="{DynamicResource Card}" Margin="0,0,10,0">
                            <StackPanel HorizontalAlignment="Center">
                                <Grid Width="100" Height="100" Margin="0,0,0,8">
                                    <Ellipse Stroke="{DynamicResource border-color}" StrokeThickness="7" Fill="Transparent"/>
                                    <Ellipse Stroke="{DynamicResource accent-blue}"
                                             StrokeThickness="7" Fill="Transparent"
                                             StrokeDashArray="{Binding CpuPercent, Converter={StaticResource PercentToDash}}"
                                             RenderTransformOrigin="0.5,0.5">
                                        <Ellipse.RenderTransform>
                                            <RotateTransform Angle="-90"/>
                                        </Ellipse.RenderTransform>
                                    </Ellipse>
                                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                        <TextBlock Text="{Binding CpuUsageText}" FontSize="22" FontWeight="Bold" Foreground="{DynamicResource text-primary}" HorizontalAlignment="Center"/>
                                        <TextBlock Text="CPU" FontSize="10" Foreground="{DynamicResource text-muted}" HorizontalAlignment="Center" Margin="0,2,0,0"/>
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- RAM Gauge -->
                        <Border Grid.Column="1" Style="{DynamicResource Card}" Margin="0,0,10,0">
                            <StackPanel HorizontalAlignment="Center">
                                <Grid Width="100" Height="100" Margin="0,0,0,8">
                                    <Ellipse Stroke="{DynamicResource border-color}" StrokeThickness="7" Fill="Transparent"/>
                                    <Ellipse Stroke="{DynamicResource accent-green}"
                                             StrokeThickness="7" Fill="Transparent"
                                             StrokeDashArray="{Binding RamPercent, Converter={StaticResource PercentToDash}}"
                                             RenderTransformOrigin="0.5,0.5">
                                        <Ellipse.RenderTransform>
                                            <RotateTransform Angle="-90"/>
                                        </Ellipse.RenderTransform>
                                    </Ellipse>
                                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                        <TextBlock Text="{Binding RamUsageText}" FontSize="22" FontWeight="Bold" Foreground="{DynamicResource text-primary}" HorizontalAlignment="Center"/>
                                        <TextBlock Text="&#x5185;&#x5B58;" FontSize="10" Foreground="{DynamicResource text-muted}" HorizontalAlignment="Center" Margin="0,2,0,0"/>
                                    </StackPanel>
                                </Grid>
                                <Button Content="&#x91CA;&#x653E;" Command="{Binding FreeMemoryCommand}"
                                        Style="{DynamicResource MiniButton}" HorizontalAlignment="Center"
                                        Margin="0"
                                        ToolTip="&#x904D;&#x5386;&#x7CFB;&#x7EDF;&#x6240;&#x6709;&#x8FDB;&#x7A0B;&#x5E76;&#x6E05;&#x7406;&#x5DE5;&#x4F5C;&#x96C6;&#xFF0C;&#x91CA;&#x653E;&#x7CFB;&#x7EDF;&#x6574;&#x4F53;&#x7269;&#x7406;&#x5185;&#x5B58;&#xFF08;&#x975E;&#x4EC5;&#x672C;&#x7A0B;&#x5E8F;&#xFF09;&#x3002;"/>
                                <TextBlock Text="{Binding ReleaseStatusMessage}" FontSize="11"
                                           Foreground="{DynamicResource accent-green}"
                                           HorizontalAlignment="Center"
                                           Margin="0,6,0,0"
                                           Visibility="{Binding ReleaseStatusMessage, Converter={StaticResource StringToVisibility}}"/>
                            </StackPanel>
                        </Border>

                        <!-- GPU Gauge -->
                        <Border Grid.Column="2" Style="{DynamicResource Card}">
                            <StackPanel HorizontalAlignment="Center">
                                <Grid Width="100" Height="100" Margin="0,0,0,8">
                                    <Ellipse Stroke="{DynamicResource border-color}" StrokeThickness="7" Fill="Transparent"/>
                                    <Ellipse Stroke="{DynamicResource accent-red}"
                                             StrokeThickness="7" Fill="Transparent"
                                             StrokeDashArray="{Binding GpuPercent, Converter={StaticResource PercentToDash}}"
                                             RenderTransformOrigin="0.5,0.5">
                                        <Ellipse.RenderTransform>
                                            <RotateTransform Angle="-90"/>
                                        </Ellipse.RenderTransform>
                                    </Ellipse>
                                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                        <TextBlock Text="{Binding GpuUsageText}" FontSize="22" FontWeight="Bold" Foreground="{DynamicResource text-primary}" HorizontalAlignment="Center"/>
                                        <TextBlock Text="GPU" FontSize="10" Foreground="{DynamicResource text-muted}" HorizontalAlignment="Center" Margin="0,2,0,0"/>
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </Border>
                    </Grid>

                    <!-- Disk Space (所有磁 ? -->
                    <TextBlock Text="&#x78C1;&#x76D8;&#x7A7A;&#x95F4;" Style="{DynamicResource SectionHeader}"/>
                    <ItemsControl ItemsSource="{Binding DriveCards}" Margin="0,0,0,15">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Style="{DynamicResource CardBorder}" Margin="0,0,0,8"
                                        Background="{DynamicResource bg-secondary}" Cursor="Hand">
                                    <Border.InputBindings>
                                        <MouseBinding MouseAction="LeftDoubleClick"
                                                      Command="{Binding DataContext.OpenDriveCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                      CommandParameter="{Binding Path}"/>
                                    </Border.InputBindings>
                                    <StackPanel>
                                        <!-- 第一行：盘符信息 | 可用空间 -->
                                        <Grid Margin="0,0,0,10">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0" Orientation="Horizontal">
                                                <TextBlock Text="&#x1F4BE;" FontSize="22" VerticalAlignment="Center" Margin="0,0,12,0"
                                                           Foreground="{DynamicResource text-secondary}"/>
                                                <StackPanel VerticalAlignment="Center">
                                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding Name}" FontSize="15" FontWeight="Bold" Foreground="{DynamicResource text-primary}" VerticalAlignment="Center"/>
                                                        <TextBlock Text=" &#x76D8;" FontSize="11" Foreground="{DynamicResource text-muted}" VerticalAlignment="Center" Margin="2,2,0,0"/>
                                                        <TextBlock Text="{Binding DisplayLabel}" FontSize="11" Foreground="{DynamicResource text-muted}" VerticalAlignment="Center" Margin="4,2,0,0"/>
                                                    </StackPanel>
                                                    <TextBlock Text="{Binding TypeText}" FontSize="11" Foreground="{DynamicResource text-muted}" Margin="0,2,0,0"/>
                                                </StackPanel>
                                            </StackPanel>
                                            <StackPanel Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right">
                                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                                    <TextBlock Text="{Binding FreeSpace}" Foreground="{DynamicResource accent-green}" FontSize="15" FontWeight="Bold"/>
                                                    <TextBlock Text=" &#x53EF;&#x7528;" Foreground="{DynamicResource text-muted}" FontSize="11" VerticalAlignment="Center" Margin="4,0,0,0"/>
                                                </StackPanel>
                                            </StackPanel>
                                        </Grid>

                                        <!-- 第二行：100% 轨道 + 已用比例填充 + 实际使用百分 ?-->
                                        <Grid Margin="0,0,0,8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <ProgressBar Grid.Column="0" Value="{Binding UsedPercent}" Maximum="100"
                                                         Style="{DynamicResource RoundedProgress}" Height="8"
                                                         Foreground="{DynamicResource accent-green}"/>
                                            <TextBlock Grid.Column="1" Text="{Binding UsedPercent, StringFormat={}{0:F1}%}"
                                                       FontSize="12" FontWeight="Bold"
                                                       Foreground="{DynamicResource text-muted}"
                                                       Margin="10,0,0,0" VerticalAlignment="Center"/>
                                        </Grid>

                                        <!-- 第三行：已用 GB | 总容 ?-->
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
